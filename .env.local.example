# Configuración de Entorno Local (Desarrollo)
VITE_APP_ENV=local
VITE_APP_NAME="AndesLog Operaciones S.A.C. (Local)"
VITE_APP_VERSION=1.0.0
VITE_BUILD_SHA=local-dev
VITE_API_URL=http://localhost:8000/api
VITE_COMPANY_NAME="AndesLog Operaciones S.A.C."
