# Configuración de Entorno Staging (Pre-producción)
VITE_APP_ENV=staging
VITE_APP_NAME="AndesLog Operaciones S.A.C. (Staging)"
VITE_APP_VERSION=1.0.0-rc
VITE_BUILD_SHA=staging-release-sha
VITE_API_URL=https://staging-autenticacion-continua-api.run.app/api
VITE_COMPANY_NAME="AndesLog Operaciones S.A.C."
VITE_LOGISTICS_ENABLED=true
VITE_STEP_UP_ENABLED=true
