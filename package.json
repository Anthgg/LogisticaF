{
  "name": "autenticacion-continua-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "openapi:check": "node scripts/validate-openapi.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "contract:audit": "node scripts/audit-api-contract.mjs",
    "contract:manifest": "node scripts/generate-contract-manifest.mjs",
    "permissions:audit": "node scripts/audit-permission-contract.mjs",
    "permissions:contract": "node scripts/generate-permission-contract.mjs",
    "permissions:contract:check": "node scripts/generate-permission-contract.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "clsx": "^2.1.1",
    "maplibre-gl": "^6.4.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tailwind-merge": "^3.6.0"
  },
  "overrides": {
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.4",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
